# 9Drive Cloudflare Tunnel config (locally-managed mode)
# Copy next to the 9drive binary as tunnel.yml, then set in .env:
#   TUNNEL_ID=your-tunnel-uuid
# One-time setup:
#   cloudflared tunnel login
#   cloudflared tunnel create 9drive      (writes <uuid>.json next to tunnel.yml)
#   cloudflared tunnel route dns 9drive drive.jhopan.my.id

tunnel: YOUR-TUNNEL-UUID
credentials-file: ./YOUR-TUNNEL-UUID.json

ingress:
  # Public domain -> local 9drive port
  - hostname: drive.jhopan.my.id
    service: http://localhost:4000
  # Add more domains/ports as needed:
  # - hostname: files.jhopan.my.id
  #   service: http://localhost:4001
  # Path routing also works:
  # - hostname: app.jhopan.my.id
  #   path: /drive
  #   service: http://localhost:4000
  - service: http_status:404
